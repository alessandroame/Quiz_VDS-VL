# Google OAuth 2.0 Client ID per backup Google Drive
# Crea un ID client OAuth applicazione Web su https://console.cloud.google.com/apis/credentials
# e aggiungi http://localhost:5173 e il tuo dominio come origini JavaScript autorizzate.
VITE_GOOGLE_CLIENT_ID=

# PostHog Telemetry & Product Analytics (Opzionale)
# Crea un progetto su https://eu.posthog.com e inserisci qui la Project API Key (phc_...)
# Se omesso o vuoto, la telemetria opera silenziosamente in modalità no-op.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://eu.i.posthog.com
