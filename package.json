{
  "name": "vds-vl-quiz-master",
  "private": true,
  "version": "1.1.6",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:visual": "node .agents/skills/headless-pwa-tester/scripts/visual_check.js desktop",
    "test:visual:portrait": "node .agents/skills/headless-pwa-tester/scripts/visual_check.js mobile-portrait",
    "test:visual:landscape": "node .agents/skills/headless-pwa-tester/scripts/visual_check.js mobile-landscape",
    "test:visual:all": "node .agents/skills/headless-pwa-tester/scripts/visual_check.js all",
    "test:visual:drive": "node scripts/test_drive_mode.js",
    "test:visual:tutor": "node scripts/test_drive_tutor.js",
    "test:visual:mic": "node scripts/test_mic_pulsing.cjs",
    "test:visual:discipline": "node scripts/test_discipline_filters.cjs",
    "test:visual:onboarding": "node scripts/test_discipline_onboarding.cjs",
    "test:visual:nav": "node scripts/test_navigator_visual.cjs",
    "test:visual:review": "node scripts/test_review_navigation_and_voice.cjs",
    "test:visual:drive:flow": "node scripts/test_drive_flow_interactive.cjs",
    "build:audio:manifest": "python scripts/generate_audio_manifest.py",
